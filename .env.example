# eBird Webhook Scraper - Environment Configuration
# Copy this to .env and fill in your values

# ============================================================================
# SERVER
# ============================================================================
PORT=3000
NODE_ENV=production

# ============================================================================
# EBIRD API
# ============================================================================
# Get your API key at https://ebird.org/api/keygen
EBIRD_API_KEY=

# ============================================================================
# SCRAPING
# ============================================================================
# Cron schedule for daily scrape (default: 6 AM)
# See https://crontab.guru for patterns
SCRAPE_SCHEDULE=0 4,10,16,22 * * *
# Number of days back to fetch notable observations (1-30)
EBIRD_DAYS_BACK=1

# ============================================================================
# SLACK INTEGRATION
# ============================================================================
# Get your webhook URL at https://api.slack.com/messaging/webhooks
SLACK_WEBHOOK_URL=

# ============================================================================
# DISCORD INTEGRATION
# ============================================================================
# Create webhooks in Discord: Server Settings → Integrations → Webhooks
# One webhook URL per county channel, plus an optional catch-all.
# County names: convert spaces to underscores and uppercase.
# Examples:
DISCORD_WEBHOOK_ALL=
DISCORD_WEBHOOK_CAPE_MAY=
DISCORD_WEBHOOK_BERGEN=
DISCORD_WEBHOOK_ESSEX=
DISCORD_WEBHOOK_HUDSON=
DISCORD_WEBHOOK_MONMOUTH=
DISCORD_WEBHOOK_OCEAN=
DISCORD_WEBHOOK_PASSAIC=
DISCORD_WEBHOOK_UNION=
# Add any other counties following the same pattern (ATLANTIC, BURLINGTON, etc.)

# ============================================================================
# EMAIL INTEGRATION
# ============================================================================
EMAIL_SERVICE=gmail
EMAIL_USER=your-email@gmail.com
EMAIL_PASSWORD=your-app-password
EMAIL_FROM=your-email@gmail.com
EMAIL_TO=recipient@example.com

# ============================================================================
# DATABASE (PostgreSQL example)
# ============================================================================
# Leave blank to use SQLite (default)
DB_HOST=
DB_PORT=
DB_USER=
DB_PASSWORD=
DB_NAME=ebird_observations

# ============================================================================
# GOOGLE SHEETS INTEGRATION
# ============================================================================
# Path to your Google service account JSON key
GOOGLE_SHEETS_KEY_FILE=
GOOGLE_SHEETS_SPREADSHEET_ID=

# ============================================================================
# TWITTER/X INTEGRATION
# ============================================================================
TWITTER_API_KEY=
TWITTER_API_SECRET=
TWITTER_ACCESS_TOKEN=
TWITTER_ACCESS_TOKEN_SECRET=

# ============================================================================
# LOGGING
# ============================================================================
LOG_LEVEL=info
LOG_FILE=

# ============================================================================
# SECURITY
# ============================================================================
# Optional: Require authentication for webhook registration
WEBHOOK_AUTH_TOKEN=
